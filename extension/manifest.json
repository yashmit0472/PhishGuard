{
  "manifest_version": 3,
  "name": "PhishGuard Local",
  "version": "2.0.0",
  "description": "Local email checks with clear English and Hindi explanations.",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "http://127.0.0.1:5000/*",
    "https://oauth2.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "80323094502-7qgnkui7osk06dbtmp1l7ps9j8ilft7l.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "background": {
    "service_worker": "local-background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "local-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "PhishGuard settings",
    "default_popup": "options.html"
  }
}
