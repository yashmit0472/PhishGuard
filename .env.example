# MongoDB Connection:
# For local MongoDB: mongodb://localhost:27017/phishing-investigator
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/phishing-investigator?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/phishing-investigator

# Local tests/demos can set USE_FAKE_DB=1 to use the in-memory Mongo-compatible store.
# Set AUTO_FALLBACK_DB=1 to fall back gracefully if remote database connection drops.
USE_FAKE_DB=0
AUTO_FALLBACK_DB=0

# Stage E external lookups are off by default so the end-to-end pipeline can
# run without API keys/network. Set THREAT_INTEL_LIVE=1 when keys are ready.
THREAT_INTEL_LIVE=0
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Stage G uses offline fallback if GEMINI_API_KEY is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
